# ==============================================================================
# ZentoPay Environment Variables Template
# Copy this file to .env for local development. Never commit real secrets.
# On Vercel, add all variables in: Project Settings -> Environment Variables
# ==============================================================================

# Public App Base URL (optional; e.g. https://zento-pay.vercel.app)
APP_URL=""

# Supabase Public Client Configuration (bundled into Vite frontend — safe for browser)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Supabase Server-Side Configuration (KEEP STRICTLY SERVER-SIDE — never prefix with VITE_)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Local Server Port (defaults to 3000)
PORT="3000"
